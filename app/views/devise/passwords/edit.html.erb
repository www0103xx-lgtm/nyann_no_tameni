<h1 class="site-title">
  <%= link_to "にゃんのために。", root_path %>
</h1>

<h2>パスワードを再設定</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <% password_confirmation_errors = resource.errors.details[:password_confirmation].pluck(:error) %>

  <% if password_confirmation_errors.include?(:confirmation) %>
    <div id="error_explanation">
      <p>パスワードが一致しませんでした。もう一度やり直してください</p>
    </div>
  <% else %>
    <%= render "devise/shared/error_messages", resource: resource %>
  <% end %>

  <%= f.hidden_field :reset_password_token %>

  <div class="field">
    <p><%= f.label :password, "新しいパスワード" %></p>
    <% if @minimum_password_length %>
      <p><em>（<%= @minimum_password_length %>文字以上）</em></p>
    <% end %>
    <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "新しいパスワード（確認）" %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "パスワードを変更" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
