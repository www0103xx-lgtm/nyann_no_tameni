<h1 class="site-title">
  <%= link_to "にゃんのために。", root_path %>
</h1>

<h2>ユーザー登録</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <% email_errors = resource.errors.details[:email].pluck(:error) %>
  <% password_errors = resource.errors.details[:password].pluck(:error) %>
  <% password_confirmation_errors = resource.errors.details[:password_confirmation].pluck(:error) %>
  <% email_taken = email_errors.include?(:taken) %>

  <% if email_taken %>
    <div id="error_explanation" data-turbo-temporary>
      <p>登録できませんでした。入力内容をご確認ください。</p>
    </div>
  <% end %>

  <div class="field">
    <p><%= f.label :name, "名前" %></p>
    <p><%= f.text_field :name, autofocus: true, autocomplete: "name" %></p>

    <% if resource.errors[:name].present? %>
      <p class="registration-form__error">*名前を入力してください</p>
    <% end %>
  </div>

  <div class="field">
    <p><%= f.label :email, "メールアドレス" %></p>
    <p><%= f.email_field :email, autocomplete: "email" %></p>

    <% unless email_taken %>
      <% if email_errors.include?(:blank) %>
        <p class="registration-form__error">*メールアドレスを入力してください</p>
      <% elsif email_errors.include?(:invalid) %>
        <p class="registration-form__error">*メールアドレスを正しく入力してください</p>
      <% end %>
    <% end %>
  </div>

  <div class="field">
    <p><%= f.label :password, "パスワード" %></p>
    <% if @minimum_password_length %>
      <p><em>（<%= @minimum_password_length %>文字以上）</em></p>
    <% end %>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>

    <% if password_errors.include?(:blank) %>
      <p class="registration-form__error">*パスワードを入力してください</p>
    <% elsif password_errors.include?(:too_short) %>
      <p class="registration-form__error">*パスワードは<%= @minimum_password_length %>文字以上で入力してください</p>
    <% end %>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "パスワード確認" %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>

    <% if password_confirmation_errors.include?(:blank) %>
      <p class="registration-form__error">*パスワード確認を入力してください</p>
    <% elsif password_confirmation_errors.include?(:confirmation) %>
      <p class="registration-form__error">*パスワードが一致していません</p>
    <% end %>
  </div>

  <div class="actions">
    <%= f.submit "登録する" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
